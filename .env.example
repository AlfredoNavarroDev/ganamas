# Copiar a .env en la raíz para sobreescribir los defaults de docker-compose.yml.
# Sin este archivo, `docker compose up` igual funciona con los valores por
# defecto (útil para probar rápido, pero cámbialos si vas a exponer esto).

POSTGRES_USER=sap_hermana
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sap_hermana

JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
SEED_USERNAME=admin
SEED_PASSWORD=change-me
LOW_STOCK_THRESHOLD=5
