# Copiar a .env en la raíz para configurar docker compose. La DB siempre es
# Supabase — completar con tu connection string real del session pooler (el
# host directo es IPv6-only, no conecta desde Docker Desktop en la mayoría de
# setups). Nunca commitear este archivo con valores reales — .env está en
# .gitignore, .env.example no.
DATABASE_URL=postgresql://usuario:password@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
SEED_USERNAME=admin
SEED_PASSWORD=change-me
LOW_STOCK_THRESHOLD=5
