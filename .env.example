# Copiar a .env en la raíz para configurar docker compose. La DB siempre es
# Neon — completar con tu connection string real (pooled, `-pooler` en el
# host), tomada directo del dashboard de Neon.
# Nunca commitear este archivo con valores reales — .env está en
# .gitignore, .env.example no.
DATABASE_URL="postgresql://usuario:password@ep-example-pooler.c-2.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_SSL=true

FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
SEED_USERNAME=admin
SEED_PASSWORD=change-me
LOW_STOCK_THRESHOLD=5
